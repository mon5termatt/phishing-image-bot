DISCORD_TOKEN=your_bot_token_here
# Required for automatic image scanning: enable "Message Content Intent" in the
# Discord Developer Portal, then set this to true.
ENABLE_MESSAGE_CONTENT=true
# Optional: sync slash commands instantly to one server during development.
# DEV_GUILD_ID=123456789012345678
# Optional: where /imgcheck synchashes downloads the community hash list from.
# PUBLIC_HASHES_URL=https://raw.githubusercontent.com/mon5termatt/phishing-image-bot/main/hashes.txt
# Optional: where settings + hashes are stored (default data/data.json).
# DATA_FILE=data/data.json
